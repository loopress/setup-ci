{
  "$schema": "https://loopress.dev/schema/global-config.json",
  "currentProject": {
    "env": "local",
    "id": "${SITE_ID}"
  },
  "projects": {
    "${SITE_ID}": {
      "addedAt": "${ADDED_AT}",
      "environments": {
        "local": {
          "addedAt": "${ADDED_AT}",
          "name": "local",
          "token": "admin:${APP_PASSWORD}",
          "url": "http://${WP_HOST}:${WP_PORT}"
        }
      },
      "name": "${SITE_ID}"
    }
  }
}
